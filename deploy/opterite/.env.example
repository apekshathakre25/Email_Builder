# Copy to .env on the server and fill in real values there.
# Never commit the server's .env file or put these values in an image.

# Use the dedicated Opterite database path, not the Bulk Email Sender database.
MONGODB_URI=mongodb+srv://<opterite-user>:<password>@<cluster-host>/opterite?retryWrites=true&w=majority
NODE_ENV=production 
# Generate strong random values for the deployment; don't reuse other app secrets.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters-generated-for-opterite

# One or more permitted login identities, in email:Display Name format.
AUTHORIZED_USERS=operator@example.net:Opterite Operator


# Required in production for OTP email delivery.
BREVO_API_KEY=replace-with-opterite-brevo-api-key
SMTP_FROM_EMAIL=opterite@example.net
BREVO_SENDER_NAME=Opterite

# Optional Google OAuth. If enabled, configure this exact callback with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://opterite.in/auth/google/callback

# Same-origin SPA/API deployment.
FRONTEND_URL=https://opterite.in
CORS_ORIGINS=https://opterite.in
COOKIE_SAMESITE=strict

# Optional application tuning. Review before changing production behavior.
WORKER_CONCURRENCY=20
MAX_UPLOAD_MB=25
MAX_REQUEST_BODY_MB=10
TRUST_PROXY=1
SESSION_SECRET=
DB_CLEANUP_ENABLED=true
DB_CLEANUP_DAYS=3
DB_CLEANUP_INTERVAL_HOURS=6
DB_CLEANUP_BATCH_SIZE=1000
DB_CLEANUP_MAX_DELETES_PER_RUN=250000
DB_CLEANUP_UPLOADED_FILES=true
