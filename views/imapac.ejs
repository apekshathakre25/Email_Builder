<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="icon" href="/images/favicon.ico" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background-color: #fafafa;
      color: #09090b;
    }

    .shadcn-card {
      background-color: #ffffff;
      border: 1px solid #e4e4e7;
      border-radius: 0.5rem;
      box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }

    .shadcn-input {
      width: 100%;
      border: 1px solid #e4e4e7;
      border-radius: 0.375rem;
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
      background-color: #ffffff;
      transition: border-color 0.2s, ring 0.2s;
    }

    .shadcn-input:focus {
      outline: none;
      border-color: #a1a1aa;
      box-shadow: 0 0 0 2px #f4f4f5;
    }

    .shadcn-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 0.375rem;
      font-size: 0.875rem;
      font-weight: 500;
      padding: 0.5rem 1rem;
      transition: background-color 0.2s;
      cursor: pointer;
    }

    .shadcn-button-primary {
      background-color: #007bff;
      color: #ffffff;
    }

    .shadcn-button-primary:hover {
      background-color: #0056b3;
    }

    .shadcn-button-outline {
      background-color: transparent;
      border: 1px solid #e4e4e7;
      color: #18181b;
    }

    .shadcn-button-outline:hover {
      background-color: #f4f4f5;
    }

    .shadcn-button-ghost {
        background-color: transparent;
        color: #18181b;
    }

    .shadcn-button-ghost:hover {
        background-color: #f4f4f5;
    }

    .shadcn-label {
      font-size: 0.875rem;
      font-weight: 500;
      color: #09090b;
      margin-bottom: 0.375rem;
      display: block;
    }

    .status-toast {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 50;
        padding: 1rem;
        border-radius: 0.5rem;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        display: none;
        animation: slideIn 0.3s ease-out;
    }

    @keyframes slideIn {
        from { transform: translateY(100%); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    /* Custom scrollbar for better look */
    ::-webkit-scrollbar {
      width: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f4f4f5;
    }
    ::-webkit-scrollbar-thumb {
      background: #d4d4d8;
      border-radius: 10px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #a1a1aa;
    }
    
    .table-container {
      overflow-x: auto;
    }
    
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.875rem;
    }
    
    th {
      text-align: left;
      padding: 0.75rem;
      background-color: #f9fafb;
      font-weight: 600;
      color: #374151;
      border-bottom: 1px solid #e5e7eb;
    }
    
    td {
      padding: 0.75rem;
      border-bottom: 1px solid #f3f4f6;
      color: #4b5563;
    }

    tr:hover td {
      background-color: #fafafa;
    }

    /* Modal / Dialog Styling */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      animation: fadeIn 0.15s ease-out;
    }

    .modal-overlay.active {
      display: flex;
    }

    .modal-content {
      background: #ffffff;
      border: 1px solid #e4e4e7;
      border-radius: 0.5rem;
      width: 100%;
      max-width: 450px;
      padding: 1.5rem;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
      transform: scale(0.95);
      animation: modalIn 0.2s ease-out forwards;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes modalIn {
      from { transform: scale(0.95); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    .modal-header {
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .modal-header h2 {
      font-size: 1.125rem;
      font-weight: 600;
      margin: 0;
    }

    .modal-body {
      font-size: 0.875rem;
      color: #71717a;
      line-height: 1.5;
      margin-bottom: 1.5rem;
    }

    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 0.75rem;
    }

    .modal-icon {
      font-size: 1.25rem;
    }

    .icon-success { color: #10b981; }
    .icon-error { color: #ef4444; }
    .icon-info { color: #3b82f6; }
    .icon-warning { color: #f59e0b; }
  </style>
</head>

<body class="min-h-screen">

  <nav class="border-b bg-white py-4 px-6 flex justify-between items-center sticky top-0 z-30">
    <div class="flex items-center gap-8">
      <div class="flex items-center gap-2">
         <img src="/images/favicon.ico" alt="Logo" class="w-10 h-10 rounded-full border border-zinc-100 shadow-sm" />
         <span class="text-xl font-bold text-zinc-900 tracking-tight">Bulk Email Sender</span>
      </div>
      
      <!-- Center Navigation -->
      <div class="hidden md:flex items-center gap-1 bg-zinc-100/50 p-1 rounded-lg border border-zinc-200/50">
          <a href="/interface" class="px-4 py-1.5 rounded-md text-sm font-medium text-zinc-600 hover:text-zinc-900 transition-all">
              <i class="fa-solid fa-chart-line mr-1.5 text-zinc-400"></i> Interface
          </a>
          <a href="/imapac" class="px-4 py-1.5 rounded-md text-sm font-medium text-blue-600 bg-white shadow-sm border border-zinc-200 transition-all">
              <i class="fa-solid fa-server mr-1.5 text-blue-500"></i> IMAP Setup
          </a>

      </div>
    </div>
    
    <div class="flex items-center gap-6">
        <div class="text-[0.9rem] text-zinc-600 font-medium">
            <%= (user && user.name) ? user.name : 'Tejas Bansod' %> | <span class="text-zinc-500 font-normal"><%= (user && user.email) ? user.email : 'tejasbansod584@gmail.com' %></span>
        </div>
        <a href="/logout" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg text-sm font-semibold flex items-center gap-2 shadow-sm transition-all active:scale-95">
            <i class="fa-solid fa-right-from-bracket"></i>
            Logout
        </a>
    </div>
  </nav>

  <main class="w-full p-4 md:p-6 h-[calc(100vh-70px)]">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 h-full">
      
      <!-- Left Column: Forms -->
      <div class="lg:col-span-5 space-y-6">
        
        

        <!-- Add IMAP Account -->
        <div class="shadcn-card p-6">
            <div class="flex items-center gap-2 mb-6">
              <div class="bg-zinc-100 p-2 rounded-lg text-zinc-900">
                  <i class="fa-solid fa-user-plus"></i>
              </div>
              <div>
                  <h2 class="text-lg font-semibold tracking-tight">Add New Account</h2>
                  <p class="text-sm text-zinc-500">Connect a new IMAP mail account.</p>
              </div>
            </div>
            
            <div class="space-y-4">
              <div>
                <label for="test-email" class="shadcn-label">Email Address</label>
                <input type="email" id="test-email" name="test-email" class="shadcn-input" placeholder="user@example.com" />
              </div>
              
              <div>
                <label for="test-email-password" class="shadcn-label">App Password</label>
                <div class="relative">
                  <input type="password" id="test-email-password" name="test-email-password" class="shadcn-input pr-10" placeholder="••••••••••••••••" />
                  <button type="button" id="toggle-test-email-pass" class="absolute right-3 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-zinc-600">
                    <i id="test-email-pass-eye" class="fa-solid fa-eye"></i>
                  </button>
                </div>
                <p class="text-[0.7rem] text-zinc-400 mt-1.5 flex items-center gap-1">
                    <i class="fa-solid fa-circle-info"></i>
                    Use app-specific passwords for Gmail/Yahoo accounts.
                </p>
              </div>
              
              <button type="button" id="add-test-email" class="shadcn-button shadcn-button-primary w-full gap-2 mt-2">
                <i class="fa-solid fa-plus"></i>
                Add Account
              </button>
            </div>
        </div>

        <!-- IMAP Server Credentials -->
        <div class="shadcn-card p-6">
          <div class="flex items-center gap-2 mb-6">
            <div class="bg-zinc-100 p-2 rounded-lg text-zinc-900">
                <i class="fa-solid fa-server"></i>
            </div>
            <div>
                <h2 class="text-lg font-semibold tracking-tight">Server Credentials</h2>
                <p class="text-sm text-zinc-500">Configure your IMAP server settings.</p>
            </div>
          </div>
          
          <div class="space-y-4">
            <div>
              <label for="imap-host" class="shadcn-label">IMAP Host</label>
              <input type="text" id="imap-host" name="imap-host" class="shadcn-input" placeholder="imap.gmail.com" />
            </div>
            
            <div class="grid grid-cols-2 gap-4">
               <div>
                  <label for="imap-port" class="shadcn-label">Port</label>
                  <input type="number" id="imap-port" name="imap-port" class="shadcn-input" placeholder="993" value="993" />
               </div>
               <div class="flex flex-col justify-end">
                  <div class="flex items-center gap-2 py-2">
                    <input type="checkbox" id="imap-ssl" name="imap-ssl" checked class="w-4 h-4 rounded border-zinc-300 text-zinc-900 focus:ring-zinc-900" />
                    <label for="imap-ssl" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Use SSL/TLS</label>
                  </div>
               </div>
            </div>
            
            <button type="button" id="save-imap-credentials" class="shadcn-button shadcn-button-primary w-full gap-2 mt-2">
              <i class="fa-solid fa-save"></i>
              Save Configuration
            </button>
          </div>
        </div>

      </div>

      <!-- Right Column: Table -->
      <div class="lg:col-span-7 h-full">
        
        <!-- Connected Accounts Table -->
        <div class="shadcn-card flex flex-col h-full overflow-hidden">
            <div class="p-6 border-b border-zinc-100 flex justify-between items-center bg-zinc-50/30">
                <div>
                    <h2 class="text-lg font-semibold tracking-tight">Connected Accounts</h2>
                    <p class="text-sm text-zinc-500">Manage and verify your IMAP accounts.</p>
                </div>
                <div class="flex flex-col items-end gap-2">
                    <!-- <button id="check-both" class="shadcn-button shadcn-button-primary gap-2 shadow-sm whitespace-nowrap">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        Verify Selections
                    </button> -->
                    <div id="current-email-display" style="display:none;" class="text-[0.7rem] text-zinc-500 bg-zinc-100 px-2 py-0.5 rounded-full max-w-[250px] truncate">
                        <span class="font-semibold mr-1">Active:</span><span id="current-email-text"></span>
                    </div>
                </div>
            </div>
            
            <div class="flex-1 overflow-auto table-container p-4">
                <table id="accounts-table">
                    <thead>
                        <tr>
                            <!-- <th class="w-[50px]">Select</th> -->
                            <th>Email Address</th>
                            <th>App Password</th>
                            <th>Date Added</th>
                            <th class="text-right whitespace-nowrap">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="test-emails-list">
                        <!-- Populated by JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>
      </div>

    </div>
  </main>

  <!-- Custom Dialog Modal -->
  <div id="modal-overlay" class="modal-overlay">
    <div class="modal-content">
      <div class="modal-header" id="modal-header">
        <i id="modal-icon" class="fa-solid modal-icon"></i>
        <h2 id="modal-title">Notification</h2>
      </div>
      <div class="modal-body" id="modal-body"></div>
      <div class="modal-footer" id="modal-footer">
        <button id="modal-cancel-btn" class="shadcn-button shadcn-button-outline" style="display: none;">Cancel</button>
        <button id="modal-ok-btn" class="shadcn-button shadcn-button-primary">OK</button>
      </div>
    </div>
  </div>

  <div id="status-display" class="status-toast bg-white border border-zinc-200"></div>

  <script src="/js/imap-checker.js"></script>
  <script>
    function showDialog({ title, message, type = 'info', confirm = false }) {
      return new Promise((resolve) => {
        const overlay = document.getElementById('modal-overlay');
        const titleEl = document.getElementById('modal-title');
        const bodyEl = document.getElementById('modal-body');
        const iconEl = document.getElementById('modal-icon');
        const okBtn = document.getElementById('modal-ok-btn');
        const cancelBtn = document.getElementById('modal-cancel-btn');

        titleEl.textContent = title || (confirm ? 'Confirm' : 'Notification');
        bodyEl.textContent = message;

        // Icon and Type
        iconEl.className = 'fa-solid modal-icon';
        if (type === 'success') iconEl.classList.add('fa-circle-check', 'icon-success');
        else if (type === 'error') iconEl.classList.add('fa-circle-xmark', 'icon-error');
        else if (type === 'warning') iconEl.classList.add('fa-triangle-exclamation', 'icon-warning');
        else iconEl.classList.add('fa-circle-info', 'icon-info');

        cancelBtn.style.display = confirm ? 'inline-flex' : 'none';
        okBtn.className = (type === 'error' || type === 'warning') ? 'shadcn-button bg-red-500 hover:bg-red-600 text-white' : 'shadcn-button shadcn-button-primary';
        okBtn.textContent = confirm ? 'Confirm' : 'OK';

        overlay.classList.add('active');

        const cleanup = (val) => {
          overlay.classList.remove('active');
          okBtn.onclick = null;
          cancelBtn.onclick = null;
          resolve(val);
        };

        okBtn.onclick = () => cleanup(true);
        cancelBtn.onclick = () => cleanup(false);
      });
    }
    
    window.showDialog = showDialog;

    function showError(msg) {
      const statusDisplay = document.getElementById('status-display');
      if (statusDisplay) {
        statusDisplay.innerHTML = msg;
        statusDisplay.style.display = 'block';
        
        // Remove existing classes
        statusDisplay.className = 'status-toast bg-white border';
        
        if (msg.includes('✅')) {
            statusDisplay.classList.add('border-green-200', 'text-green-800');
        } else if (msg.includes('⚠️')) {
            statusDisplay.classList.add('border-yellow-200', 'text-yellow-800');
        } else if (msg.includes('❌')) {
            statusDisplay.classList.add('border-red-200', 'text-red-800');
        } else {
            statusDisplay.classList.add('border-zinc-200', 'text-zinc-800');
        }
        
        setTimeout(() => {
          statusDisplay.style.display = 'none';
        }, 5000);
      } else {
        alert(msg);
      }
    }
    
    window.showError = showError;
  </script>
</body>

</html>
